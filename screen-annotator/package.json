{
  "name": "screen-annotator-pro",
  "productName": "Screen Annotator Pro",
  "version": "1.0.0",
  "description": "Pro on-screen annotation for online teaching: draw, highlight, spotlight, magnify and present on top of any app.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.screenannotator.pro",
    "productName": "Screen Annotator Pro",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Screen Annotator Pro captures the screen for screenshots and the magnifier."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    }
  }
}
